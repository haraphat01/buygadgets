// Prisma schema for BuyGadgets
// See Project.md "Database Tables" for the source list of tables this maps to.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url / directUrl are configured in prisma.config.ts (Prisma 7)
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PAYSTACK
  CREDIT_DIRECT
  KLUMP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum DeliveryMethodType {
  BUYGADGETS
  GIG_LOGISTICS
  PICKUP
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  ORDER_SHIPPED
  ORDER_DELIVERED
  READY_FOR_PICKUP
  NEW_ORDER
  LOW_STOCK
  OUT_OF_STOCK
  NEW_REVIEW
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Extends a Supabase `auth.users` row. `id` matches `auth.users.id` and is
/// assigned on creation (not generated here) — Prisma does not manage the
/// `auth` schema so this is not an enforced foreign key.
model Profile {
  id        String   @id @db.Uuid
  fullName  String?  @map("full_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adminUser     AdminUser?
  customer      Customer?
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@map("profiles")
}

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @unique @map("profile_id") @db.Uuid
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role        AdminRole @default(STAFF)
  permissions Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

/// A registered or guest customer. Guests get a row with `isGuest = true`
/// and no `profileId` (no Supabase auth account).
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String?  @unique @map("profile_id") @db.Uuid
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  isGuest   Boolean  @default(false) @map("is_guest")
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlists    Wishlist[]
  compareItems CompareItem[]
  cartItems    CartItem[]

  @@map("customers")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  phone      String
  state      String
  city       String
  address    String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?    @map("image_url")
  parentId    String?    @map("parent_id") @db.Uuid
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")
  products    Product[]
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  logoUrl     String?   @map("logo_url")
  description String?
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  brandId         String?          @map("brand_id") @db.Uuid
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId      String?          @map("category_id") @db.Uuid
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sku             String           @unique
  description     String?
  price           Decimal          @db.Decimal(12, 2)
  discountPrice   Decimal?         @map("discount_price") @db.Decimal(12, 2)
  flashSaleEndsAt DateTime?        @map("flash_sale_ends_at")
  quantity        Int              @default(0)
  condition       ProductCondition @default(NEW)
  warranty        String?
  ram             String?
  storage         String?
  processor       String?
  battery         String?
  camera          String?
  display         String?
  featured        Boolean          @default(false)
  newArrival      Boolean          @default(false) @map("new_arrival")
  published       Boolean          @default(false)
  archived        Boolean          @default(false)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  images       ProductImage[]
  variants     ProductVariant[]
  inventory    Inventory[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlists    Wishlist[]
  compareItems CompareItem[]
  cartItems    CartItem[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?  @map("alt_text")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String   @unique
  price      Decimal? @db.Decimal(12, 2)
  quantity   Int      @default(0)
  /// e.g. { "color": "Black", "storage": "256GB" }
  attributes Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  inventory  Inventory[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id                String          @id @default(uuid()) @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?         @map("variant_id") @db.Uuid
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int             @default(0)
  lowStockThreshold Int             @default(5) @map("low_stock_threshold")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([productId, variantId])
  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Shopping (cart, wishlist, compare)
// ---------------------------------------------------------------------------

/// `customerId` is set for signed-in shoppers; `sessionId` (a cookie-backed
/// anonymous id) is used for guests so carts survive without an account.
model CartItem {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String?         @map("customer_id") @db.Uuid
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?         @map("session_id")
  productId  String          @map("product_id") @db.Uuid
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?         @map("variant_id") @db.Uuid
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([sessionId])
  @@map("cart_items")
}

model Wishlist {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, productId])
  @@map("wishlists")
}

/// Spec caps comparison at 2 products; enforced in the application layer.
model CompareItem {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?   @map("session_id")
  productId  String    @map("product_id") @db.Uuid
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([customerId])
  @@index([sessionId])
  @@map("compare_items")
}

// ---------------------------------------------------------------------------
// Orders, payments, delivery, coupons
// ---------------------------------------------------------------------------

model DeliveryMethod {
  id            String             @id @default(uuid()) @db.Uuid
  type          DeliveryMethodType @unique
  name          String
  fee           Decimal            @default(0) @db.Decimal(12, 2)
  estimatedDays String?            @map("estimated_days")
  /// Pickup-only fields
  pickupAddress String?            @map("pickup_address")
  businessHours String?            @map("business_hours")
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  orders Order[]

  @@map("delivery_methods")
}

model Coupon {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(12, 2)
  expiryDate   DateTime?  @map("expiry_date")
  usageLimit   Int?       @map("usage_limit")
  usedCount    Int        @default(0) @map("used_count")
  minimumSpend Decimal?   @map("minimum_spend") @db.Decimal(12, 2)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  orders Order[]

  @@map("coupons")
}

/// Customer/delivery info is snapshotted at checkout (not read live off
/// `Customer`/`Address`) so historical orders stay accurate if the
/// customer later edits their profile.
model Order {
  id          String    @id @default(uuid()) @db.Uuid
  orderNumber String    @unique @map("order_number")
  customerId  String?   @map("customer_id") @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  email      String
  phone      String
  state      String
  city       String
  address    String
  orderNotes String? @map("order_notes")

  deliveryMethodId String?         @map("delivery_method_id") @db.Uuid
  deliveryMethod   DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  deliveryFee      Decimal         @default(0) @map("delivery_fee") @db.Decimal(12, 2)

  couponId String? @map("coupon_id") @db.Uuid
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod @map("payment_method")
  trackingNumber String?       @map("tracking_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items    OrderItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

/// Snapshots product name/price at time of purchase.
model OrderItem {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?         @map("product_id") @db.Uuid
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  price     Decimal         @db.Decimal(12, 2)
  quantity  Int
  subtotal  Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(12, 2)
  /// Paystack transaction reference (or manual-flow reference)
  reference        String?       @unique
  providerResponse Json?         @map("provider_response")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String       @map("customer_id") @db.Uuid
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  /// Admin reply to the review
  reply      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([productId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Site content & configuration
// ---------------------------------------------------------------------------

/// Generic admin-configurable key/value store — e.g. Paystack keys,
/// Credit Direct / Klump WhatsApp numbers and popup copy — for settings
/// that don't warrant their own table.
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  imageUrl  String    @map("image_url")
  link      String?
  /// Homepage section this banner belongs to, e.g. "hero", "promotion"
  position  String    @default("hero")
  active    Boolean   @default(true)
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("banners")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  profileId String?          @map("profile_id") @db.Uuid
  profile   Profile?         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([profileId])
  @@map("notifications")
}

/// Generic audit trail — covers admin stock-history and general activity
/// logging without introducing tables not in the spec's list.
model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("activity_logs")
}
